    - name: "\u0423\u0440\u043E\u043D \u0432\u043E\u043B\u043D\u044B, % \u0421\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438"
      value: 100
      key: damage
  - name: "\u0411\u043B\u043E\u043A"
    description: "\u0421\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0441\u0430\u043C, \u043A\u043E\u0433\u0434\u0430 \u0432\u043E \u0421\u0442\u0430\u0436\u0451\u0440\u0430 \u043F\u043E\u043F\u0430\u0434\u0430\u0435\u0442 \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0439 \u0441\u043A\u0438\u043B: \u0443\u0434\u0430\u0440 \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 (\u043D\u0438 \u0443\u0440\u043E\u043D\u0430, \u043D\u0438 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u044F, \u043D\u0438 \u0441\u0442\u0430\u043D\u0430). \u0410\u0432\u0442\u043E \u0430\u0442\u0430\u043A\u0438 \u0431\u043B\u043E\u043A \u043D\u0435 \u043B\u043E\u0432\u0438\u0442."
    cooldown: 10
    energyCost: 20
    passive: 0
    values:
    - name: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u0431\u043B\u043E\u043A, \u0441\u0435\u043A"
      value: 1
      key: time
  - name: "\u041A\u043E\u043C\u0431\u043E"
    description: "3 \u0441\u0438\u043B\u044C\u043D\u044B\u0445 \u0443\u0434\u0430\u0440\u0430 \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439: \u043A\u0430\u0436\u0434\u044B\u0439 \u2014 40% \u0421\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438 \u0438 \u0441\u0442\u0430\u043D 0.5 \u0441. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0443\u0434\u0430\u0440 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0438 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0441 \u043D\u043E\u0433."
    cooldown: 15
    energyCost: 40
    passive: 0
    values:
    - name: "\u0423\u0434\u0430\u0440\u043E\u0432"
      value: 3
      key: hits
    - name: "\u0423\u0440\u043E\u043D \u0443\u0434\u0430\u0440\u0430, % \u0421\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438"
      value: 40
