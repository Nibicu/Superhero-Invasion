    name: "\u0425\u0440\u0430\u0431\u0440\u043E\u0441\u0442\u044C"
    description: "\u0415\u0441\u043B\u0438 \u0432\u0440\u0430\u0433\u043E\u0432 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432, \u0417\u0430\u0449\u0438\u0442\u0430 +20."
    cooldown: 0
  skills:
  - name: "\u0412\u043E\u043B\u043D\u0430"
    description: "\u0417\u0430\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0432\u043E\u043B\u043D\u0443 \u044D\u043D\u0435\u0440\u0433\u0438\u0438: \u043B\u0435\u0442\u0438\u0442 \u0432\u043F\u0435\u0440\u0451\u0434, \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D \u043E\u0442 \u0410\u0442\u0430\u043A\u0438 \u0438 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u0430 \u0441 \u043D\u043E\u0433."
    cooldown: 5
  - name: "\u0411\u043B\u043E\u043A"
    description: "\u0421\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442 \u0441\u0430\u043C, \u043A\u043E\u0433\u0434\u0430 \u0432\u0440\u0430\u0433 \u0431\u044C\u0451\u0442 \u0421\u0442\u0430\u0436\u0451\u0440\u0430 \u0430\u0442\u0430\u043A\u0443\u044E\u0449\u0438\u043C \u0441\u043A\u0438\u043B\u043E\u043C: \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442 \u043B\u044E\u0431\u043E\u0439 \u0443\u0440\u043E\u043D \u0438 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u043D\u0438\u0435."
    cooldown: 10
  - name: "\u0421\u0438\u043B\u043E\u0432\u044B\u0435 \u043A\u043B\u0438\u043D\u043A\u0438"
    description: "\u041C\u043E\u0449\u043D\u0430\u044F \u0430\u0442\u0430\u043A\u0430: \u0443\u0440\u043E\u043D \u043E\u0442 \u0410\u0442\u0430\u043A\u0438 \u0432\u0441\u0435\u043C \u0432 \u0437\u043E\u043D\u0435 \u0443\u0434\u0430\u0440\u0430, \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0438\u0445 \u0441 \u043D\u043E\u0433."
    cooldown: 8
  - name: "\u041F\u0430\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435"
    description: "\u041F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439: 20% \u0448\u0430\u043D\u0441, \u0447\u0442\u043E \u0430\u0432\u0442\u043E \u0430\u0442\u0430\u043A\u0430 \u0432\u0440\u0430\u0433\u0430 \u043F\u043E \u0421\u0442\u0430\u0436\u0451\u0440\u0443 \u043D\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    cooldown: 0
  captainBonus: "+10% \u043A \u0430\u0442\u0430\u043A\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B"
