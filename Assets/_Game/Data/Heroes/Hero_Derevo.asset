  skills:
  - name: "\u041A\u043E\u0440\u043D\u0438"
    description: "3 \u043A\u043E\u0440\u043D\u044F \u0432\u044B\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0438\u0437 \u0437\u0435\u043C\u043B\u0438 \u0432\u043E\u043B\u043D\u043E\u0439 \u043F\u0435\u0440\u0435\u0434 \u0414\u0435\u0440\u0435\u0432\u043E\u043C (\u0431\u043B\u0438\u0436\u0435, \u0434\u0430\u043B\u044C\u0448\u0435, \u0435\u0449\u0451 \u0434\u0430\u043B\u044C\u0448\u0435). \u041A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432, \u0443\u0440\u043E\u043D 60% \u041C\u0430\u0433\u0438\u0438."
    cooldown: 25
    passive: 0
  - name: "\u041D\u043E\u0432\u0430\u044F \u0436\u0438\u0437\u043D\u044C"
    description: "2 \u0446\u0432\u0435\u0442\u043A\u0430 \u0438\u0437 \u0437\u0435\u043C\u043B\u0438 (\u0436\u0438\u0432\u0443\u0442 10 \u0441). \u0421\u043E\u044E\u0437\u043D\u0438\u043A \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B \u2014 +30% \u043E\u0442 \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u044E\u0449\u0435\u0433\u043E HP. \u0412\u0440\u0430\u0433 \u043F\u043E\u0434\u043E\u0448\u0451\u043B \u2014 \u0446\u0432\u0435\u0442\u043E\u043A \u0432\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0434\u044B\u043C\u043E\u043C \u043D\u0430 2 \u0441: \u0432\u0440\u0430\u0433\u0438 \u0432 \u0434\u044B\u043C\u0443 \u0448\u0430\u0442\u0430\u044E\u0442\u0441\u044F."
    cooldown: 20
    passive: 0
  - name: "\u0421\u0438\u043B\u0430 \u043F\u0440\u0438\u0440\u043E\u0434\u044B"
    description: "\u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430 \u0414\u0435\u0440\u0435\u0432\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E \u0432 \u0431\u043E\u044E, \u0442\u0435\u043C \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0431\u043E\u044F: 1000 \u0443\u0440\u043E\u043D\u0430 \u2014 +20% \u043A\u043E \u0432\u0441\u0435\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0430\u043C, 2500 \u2014 \u0435\u0449\u0451 +20%."
