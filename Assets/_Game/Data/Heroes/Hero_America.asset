  - name: "\u042D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0431\u0443\u043C\u0435\u0440\u0430\u043D\u0433"
    description: "\u041C\u0435\u0442\u0430\u0435\u0442 \u043A\u043E\u043B\u044C\u0446\u043E \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0435\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435, \u043E\u043D\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A \u0410\u043C\u0435\u0440\u0438\u043A\u0435. \u041A\u0430\u0436\u0434\u043E\u0433\u043E \u0432\u0440\u0430\u0433\u0430 \u043D\u0430 \u043F\u0443\u0442\u0438 \u0442\u0443\u0434\u0430 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0440\u0430\u043D\u0438\u0442 (60% \u0421\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438) \u0438 \u0432\u0432\u043E\u0434\u0438\u0442 \u0432 \u0433\u0440\u043E\u0433\u0438."
    cooldown: 7
    energyCost: 25
    passive: 0
    values:
    - name: "\u0423\u0440\u043E\u043D \u0431\u0443\u043C\u0435\u0440\u0430\u043D\u0433\u0430 (\u0442\u0443\u0434\u0430 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E), % \u0421\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438"
