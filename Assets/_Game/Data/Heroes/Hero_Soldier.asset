  kit: 1
  passive:
    name: "\u041C\u0435\u0442\u043A\u0438\u0439 \u0441\u0442\u0440\u0435\u043B\u043E\u043A"
    description: "20% \u0448\u0430\u043D\u0441, \u0447\u0442\u043E \u0432\u044B\u0441\u0442\u0440\u0435\u043B \u0438\u043B\u0438 \u0430\u0432\u0442\u043E \u0430\u0442\u0430\u043A\u0430 \u043D\u0430\u043D\u0435\u0441\u0451\u0442 \u0432 1.5 \u0440\u0430\u0437\u0430 \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430."
    cooldown: 0
  skills:
  - name: "\u0417\u0430\u043B\u043F"
    description: "\u0414\u043E\u0441\u0442\u0430\u0451\u0442 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0443 \u0438 \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442 3 \u0440\u0430\u0437\u0430 \u0441 \u0438\u043D\u0442\u0435\u0440\u0432\u0430\u043B\u043E\u043C 0.5 \u0441. \u041A\u0430\u0436\u0434\u0430\u044F \u043F\u0443\u043B\u044F \u2014 70% \u0421\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438, \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u0430. \u0421\u0440\u0435\u0434\u043D\u044F\u044F \u0438 \u0434\u0430\u043B\u044C\u043D\u044F\u044F \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F."
    cooldown: 10
  - name: "\u041E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435"
    description: "\u041A\u0443\u0432\u044B\u0440\u043E\u043A \u043E\u0442 \u0432\u0440\u0430\u0433\u0430 \u043D\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 (\u0431\u0435\u0437 \u0443\u0440\u043E\u043D\u0430). \u0421\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442, \u043A\u043E\u0433\u0434\u0430 \u0417\u0430\u043B\u043F \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0436\u0430\u0435\u0442\u0441\u044F \u0438 \u0432\u0440\u0430\u0433 \u0432\u043F\u043B\u043E\u0442\u043D\u0443\u044E. \u0415\u0441\u043B\u0438 \u0443 \u0432\u0440\u0430\u0433\u0430 \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F, \u0447\u0435\u043C \u0443 \u0421\u043E\u043B\u0434\u0430\u0442\u0430, \u2014 \u043A\u0443\u0432\u044B\u0440\u043E\u043A \u043A \u0432\u0440\u0430\u0433\u0443."
    cooldown: 13
  - name: "\u0411\u0430\u0440\u044C\u0435\u0440"
    description: "\u0429\u0438\u0442 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E 30% \u043E\u0442 HP \u043D\u0430 6 \u0441 \u2014 \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u043B\u044E\u0431\u043E\u0439 \u0443\u0440\u043E\u043D. \u0412\u043E\u043A\u0440\u0443\u0433 \u0421\u043E\u043B\u0434\u0430\u0442\u0430 \u0442\u0451\u043C\u043D\u043E-\u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0448\u0430\u0440."
    cooldown: 20
  - name: "\u0421\u0432\u0435\u0440\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u043A"
    description: "\u041F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439: \u043F\u043E\u043A\u0430 HP \u043C\u0435\u043D\u044C\u0448\u0435 40%, \u0420\u0435\u0433\u0435\u043D HP +15."
    cooldown: 0
  captainBonus: "+10% \u043A \u0410\u0442\u0430\u043A\u0435 \u0438 \u0410\u0432\u0442\u043E \u0430\u0442\u0430\u043A\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B"
