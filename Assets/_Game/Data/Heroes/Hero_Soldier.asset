  sprites: {fileID: 11400000, guid: f2972bd2b0d95254e9728abfbb45297c, type: 2}
  description: "\u0421\u043E\u043B\u0434\u0430\u0442 \u0438\u0437 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0445\u043E\u0442\u0438\u043B\u0441\u044F \u043D\u0430 \u043F\u0440\u0435\u0441\u0442\u0443\u043F\u043D\u0438\u043A\u043E\u0432-\u0437\u043B\u043E\u0434\u0435\u0435\u0432. \u0423\u043C\u0435\u043B \u0441\u043A\u043E\u0432\u044B\u0432\u0430\u0442\u044C \u0432\u0440\u0430\u0433\u043E\u0432 \u0438 \u043C\u0435\u0442\u043A\u043E \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C \u0438\u0437 \u0448\u0442\u0443\u0440\u043C\u043E\u0432\u043E\u0439 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438 \u2014 \u0431\u044B\u043B \u043D\u0435\u0437\u0430\u043C\u0435\u043D\u0438\u043C."
  side: 0
  stars: 1
  hireCost: 360
  hireable: 1
  unitClass: 1
  skillDamage: 0
  baseStats:
    hp: 750
    hpRegen: 10
