  autoAttackSpeed: 100
  kit: 1
  skills:
  - name: "\u0417\u0430\u043B\u043F"
    description: "\u0414\u043E\u0441\u0442\u0430\u0451\u0442 \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0443 \u0438 \u0441\u0442\u0440\u0435\u043B\u044F\u0435\u0442 3 \u0440\u0430\u0437\u0430 \u0441 \u0438\u043D\u0442\u0435\u0440\u0432\u0430\u043B\u043E\u043C 0.5 \u0441. \u041A\u0430\u0436\u0434\u0430\u044F \u043F\u0443\u043B\u044F \u2014 70% \u0421\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438, \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u0430. \u0421\u0440\u0435\u0434\u043D\u044F\u044F \u0438 \u0434\u0430\u043B\u044C\u043D\u044F\u044F \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F."
    cooldown: 10
    energyCost: 30
    passive: 0
    values:
    - name: "\u0412\u044B\u0441\u0442\u0440\u0435\u043B\u043E\u0432"
      value: 3
      key: shots
    - name: "\u0423\u0440\u043E\u043D \u043F\u0443\u043B\u0438, % \u0421\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438"
      value: 70
      key: damage
    - name: "\u0418\u043D\u0442\u0435\u0440\u0432\u0430\u043B \u043C\u0435\u0436\u0434\u0443 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438, \u0441\u0435\u043A"
      value: 0.5
      key: interval
  - name: "\u0421\u043A\u0430\u0447\u043E\u043A"
    description: "\u041A\u043E\u0433\u0434\u0430 \u0417\u0430\u043B\u043F \u0433\u043E\u0442\u043E\u0432, \u0430 \u0432\u0440\u0430\u0433 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043B\u0438\u0437\u043A\u043E, \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0440\u0435\u043B\u044F\u0442\u044C, \u2014 \u043A\u0443\u0432\u044B\u0440\u043E\u043A \u043E\u0442 \u0432\u0440\u0430\u0433\u0430 \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u044E\u044E \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044E (\u0432\u043E \u0432\u0440\u0435\u043C\u044F \u043A\u0443\u0432\u044B\u0440\u043A\u0430 \u043D\u0435\u0443\u044F\u0437\u0432\u0438\u043C), \u043F\u043E\u0442\u043E\u043C \u0417\u0430\u043B\u043F. \u0422\u043E\u043B\u044C\u043A\u043E \u043E\u0442 \u0432\u0440\u0430\u0433\u0430."
    cooldown: 10
    energyCost: 30
    passive: 0
    values:
    - name: "\u0414\u043B\u0438\u043D\u0430 \u0441\u043A\u0430\u0447\u043A\u0430"
      value: 3.5
      key: distance
  - name: "\u0411\u0430\u0440\u044C\u0435\u0440"
    description: "\u0429\u0438\u0442 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E 30% \u043E\u0442 HP \u043D\u0430 6 \u0441 \u2014 \u0432\u043F\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u043B\u044E\u0431\u043E\u0439 \u0443\u0440\u043E\u043D. \u0412\u043E\u043A\u0440\u0443\u0433 \u0421\u043E\u043B\u0434\u0430\u0442\u0430 \u0442\u0451\u043C\u043D\u043E-\u0437\u0435\u043B\u0451\u043D\u044B\u0439 \u0448\u0430\u0440."
