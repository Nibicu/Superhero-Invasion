  skills:
  - name: "\u0428\u0430\u0440\u043C"
    description: "\u0421\u0435\u0440\u0434\u0446\u0435 \u043B\u0435\u0442\u0438\u0442 \u0432\u043E \u0432\u0440\u0430\u0433\u0430 (\u0431\u0435\u0437 \u0443\u0440\u043E\u043D\u0430). \u0420\u044F\u0434\u043E\u043C \u0441 \u0446\u0435\u043B\u044C\u044E \u043D\u0438\u043A\u043E\u0433\u043E \u0438\u0437 \u0435\u0451 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432 \u2014 \u0441\u0442\u0430\u043D 2 \u0441. \u0420\u044F\u0434\u043E\u043C \u0435\u0441\u0442\u044C \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0438 \u2014 \u0446\u0435\u043B\u044C \u0438 \u043E\u043D\u0438 2 \u0441 \u0431\u044C\u044E\u0442 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430."
    cooldown: 15
    passive: 0
    values:
    - name: "\u0421\u0442\u0430\u043D \u0438\u043B\u0438 \u0448\u0430\u0440\u043C, \u0441\u0435\u043A"
      value: 2
      key: time
  - name: "\u0421\u0430\u0439"
    description: "\u0421\u0430\u043C\u043E\u043D\u0430\u0432\u043E\u0434\u044F\u0449\u0438\u0439\u0441\u044F \u0441\u043D\u0430\u0440\u044F\u0434 \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E \u0432\u0440\u0430\u0433\u0430 (\u043B\u0435\u0442\u0438\u0442 \u0434\u043E 5 \u0441, \u043D\u0435 \u043D\u0430\u0448\u0451\u043B \u0446\u0435\u043B\u044C \u2014 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442). \u0423\u0440\u043E\u043D \u2014 100% \u041C\u0430\u0433\u0438\u0438."
    cooldown: 8
    passive: 0
    values:
    - name: "\u0423\u0440\u043E\u043D \u0441\u0430\u044F, % \u041C\u0430\u0433\u0438\u0438"
      value: 100
      key: damage
    - name: "\u0421\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442\u0438\u0442 \u0441\u0430\u0439, \u0441\u0435\u043A"
      value: 5
      key: life
  - name: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u044C\u0435"
    description: "\u0412\u0440\u0430\u0433, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u043B \u0441\u043A\u0438\u043B \u0421\u0443\u043A\u043A\u0443\u0431\u0430, \u043F\u0440\u043E\u043A\u043B\u044F\u0442 \u0434\u043E \u043A\u043E\u043D\u0446\u0430 \u0431\u043E\u044F. \u041A\u043E\u0433\u0434\u0430 \u0443 \u043D\u0435\u0433\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F 10% HP \u2014 \u0421\u0443\u043A\u043A\u0443\u0431 \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044F \u043A \u043D\u0435\u043C\u0443 \u0438 \u0441\u0440\u0430\u0437\u0443 \u0431\u044C\u0451\u0442."
    cooldown: 15
    passive: 1
    values:
    - name: "\u0422\u0435\u043B\u0435\u043F\u043E\u0440\u0442 \u043A \u043F\u043E\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u043C\u0443, \u043A\u043E\u0433\u0434\u0430 \u0443 \u043D\u0435\u0433\u043E HP \u043D\u0438\u0436\u0435, %"
      value: 10
      key: hp
