    name: "\u041F\u044F\u0442\u044B\u0439 \u0443\u0434\u0430\u0440"
    description: "\u041A\u0430\u0436\u0434\u0430\u044F 5-\u044F \u0430\u0432\u0442\u043E \u0430\u0442\u0430\u043A\u0430 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u0443\u0440\u043E\u043D."
    cooldown: 0
  skills:
  - name: "\u041A\u043B\u043E\u043D\u044B"
    description: "\u0412\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442 3 \u0441\u0432\u043E\u0438\u0445 \u0442\u0451\u043C\u043D\u044B\u0445 \u043A\u043B\u043E\u043D\u0430 \u2014 \u0431\u043E\u0439\u0446\u043E\u0432 \u0441 30% \u0435\u0433\u043E \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A. \u041F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435 \u0433\u0438\u0431\u0435\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u043A\u043B\u043E\u043D\u0430."
    cooldown: 20
  - name: "\u042D\u043D\u0435\u0440\u0433\u043E \u0448\u0430\u0440"
    description: "\u041C\u0435\u0440\u0446\u0430\u044E\u0449\u0438\u0439 \u043A\u0440\u0430\u0441\u043D\u043E-\u0440\u043E\u0437\u043E\u0432\u044B\u0439 \u0448\u0430\u0440 \u043B\u0435\u0442\u0438\u0442 \u0432\u043E \u0432\u0440\u0430\u0433\u0430: \u0443\u0440\u043E\u043D \u043E\u0442 \u0421\u0438\u043B\u044B \u0430\u0442\u0430\u043A\u0438, \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0441 \u043D\u043E\u0433."
    cooldown: 6
  - name: "\u0422\u0435\u043B\u0435\u043F\u043E\u0440\u0442"
    description: "\u041A\u043E\u0433\u0434\u0430 HP \u043C\u0435\u043D\u044C\u0448\u0435 20%: \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0432 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u0443\u044E \u0442\u043E\u0447\u043A\u0443 \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0451\u043A\u0443, \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435 \u043E\u0442 \u0432\u0440\u0430\u0433\u043E\u0432."
    cooldown: 10
  - name: "\u0422\u0435\u043D\u044C"
    description: "\u041F\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439: \u0417\u0430\u0449\u0438\u0442\u0430 \u0438 \u0421\u043F\u0435\u0446. \u0437\u0430\u0449\u0438\u0442\u0430 +25."
    cooldown: 0
  captainBonus: "\u041A\u043E\u043C\u0430\u043D\u0434\u0430 \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u0430: +10% \u043A \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438"
